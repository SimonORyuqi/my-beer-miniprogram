/**app.wxss - 全局样式**/
/* 浅色温馨主题 - 社区客厅风格 */

page {
  background: #FFF8F0;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
  color: #333333;
  font-size: 28rpx;
  line-height: 1.6;
}

/* 全局容器 */
.container {
  min-height: 100vh;
  padding: 24rpx;
  box-sizing: border-box;
}

/* 通用按钮样式 */
.btn-primary {
  background: #D4A017;
  color: #FFFFFF;
  border: none;
  border-radius: 8rpx;
  padding: 24rpx 48rpx;
  font-size: 28rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-primary:active {
  background: #BF8E14;
  transform: scale(0.98);
}

.btn-primary.disabled {
  background: #CCCCCC;
  color: #999999;
}

.btn-secondary {
  background: #FFFFFF;
  color: #D4A017;
  border: 2rpx solid #D4A017;
  border-radius: 8rpx;
  padding: 22rpx 48rpx;
  font-size: 28rpx;
}

/* 卡片样式 */
.card {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(139, 69, 19, 0.08);
}

/* 标题样式 */
.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 20rpx;
}

/* 价格样式 */
.price {
  color: #E85A4F;
  font-weight: bold;
  font-size: 32rpx;
}

.price-original {
  color: #999999;
  text-decoration: line-through;
  font-size: 24rpx;
  margin-left: 12rpx;
}

/* 标签样式 */
.tag {
  display: inline-block;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  font-size: 22rpx;
  background: rgba(212, 160, 23, 0.15);
  color: #D4A017;
}

.tag-promo {
  background: rgba(232, 90, 79, 0.15);
  color: #E85A4F;
}

/* 分割线 */
.divider {
  height: 1rpx;
  background: #E8E0D8;
  margin: 20rpx 0;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
  color: #D4A017;
}

.empty-state image {
  width: 160rpx;
  height: 160rpx;
  margin-bottom: 24rpx;
  opacity: 0.6;
}

.empty-state text {
  font-size: 28rpx;
  color: #666666;
}

/* 加载动画 */
.loading {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  color: #D4A017;
}
