<view class="container">
  <!-- 顶部背景图区域 -->
  <view class="header-bg">
    <image class="bg-image" src="/images/bg-beer.png" mode="aspectFill"></image>
    <view class="bg-blur"></view>
  </view>

  <!-- 内容区域 -->
  <view class="content-wrapper">
    <!-- 会员卡片 -->
    <view class="member-card card">
      <!-- 会员信息 -->
      <view class="member-header">
        <view class="member-info">
          <image class="avatar" src="{{userInfo.avatar}}" mode="aspectFill"></image>
          <view class="member-text">
            <text class="member-name">Hi,{{userInfo.nickname}}</text>
            <view class="member-id">NO.{{userInfo.memberId}}</view>
          </view>
        </view>
        <view class="vip-section">
          <view class="vip-badge" bindtap="goToVip">
            <text class="vip-badge-icon">💎</text>
            <text class="vip-badge-text">{{userInfo.vipName}}</text>
            <text class="vip-badge-arrow">›</text>
          </view>
          <view class="vip-progress-text" bindtap="goToVip">
            <text>再消费{{userInfo.nextLevelAmount}}元升为{{userInfo.nextVipName}}</text>
          </view>
        </view>
      </view>

      <!-- 功能入口 -->
      <view class="member-actions">
        <view class="member-action-btn" bindtap="goToOrder">
          <view class="member-action-icon">📋</view>
          <text class="member-action-text">点单</text>
        </view>
        <view class="member-action-divider"></view>
        <view class="member-action-btn" bindtap="goToPoints">
          <view class="member-action-icon">🎁</view>
          <text class="member-action-text">积分商城</text>
        </view>
        <view class="member-action-divider"></view>
        <view class="member-action-btn" bindtap="goToVip">
          <view class="member-action-icon">💎</view>
          <text class="member-action-text">会员充值</text>
        </view>
      </view>
    </view>

    <!-- 订单中心卡片 -->
    <view class="order-card card" bindtap="goToOrders">
      <view class="order-card-left">
        <text class="order-card-icon">📋</text>
        <text class="order-card-text">订单中心</text>
      </view>
      <view class="order-card-right">
        <text>查看所有订单</text>
        <text class="order-card-arrow">›</text>
      </view>
    </view>

    <!-- 门店折叠卡片 -->
    <view class="store-collapse-card card">
      <view class="store-collapse-header" bindtap="toggleStoreCollapse">
        <view class="store-collapse-left">
          <text class="store-collapse-icon">🍺</text>
          <text class="store-collapse-title">地酒精酿</text>
        </view>
        <view class="store-collapse-right">
          <text class="store-collapse-arrow {{storeCollapsed ? '' : 'expanded'}}">›</text>
        </view>
      </view>
      <view class="store-collapse-content {{storeCollapsed ? 'collapsed' : ''}}">
        <view class="store-details">
          <view class="store-row">
            <text class="store-icon">📍</text>
            <text class="store-text">{{storeInfo.address}}</text>
          </view>
          <view class="store-row">
            <text class="store-icon">🕐</text>
            <text class="store-text">{{storeInfo.hours}}</text>
          </view>
          <view class="store-row">
            <text class="store-icon">📞</text>
            <text class="store-text">{{storeInfo.phone}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 温馨提示 -->
    <view class="tips">
      <text class="tips-text">🍻 温馨提示：购买酒类商品需年满18周岁</text>
    </view>
  </view>

  <!-- 登录弹窗 -->
  <view class="login-modal {{showLoginModal ? 'show' : ''}}" wx:if="{{showLoginModal}}">
    <view class="login-mask"></view>
    <view class="login-content">
      <view class="login-header">
        <text class="login-title">欢迎来到地酒精酿</text>
        <text class="login-subtitle">请先注册</text>
      </view>
      
      <!-- 头像预览 -->
      <button class="preview-item choose-avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
        <text class="preview-label">头像</text>
        <view class="preview-right">
          <image class="preview-avatar" src="{{tempAvatar}}" mode="aspectFill"></image>
          <text class="preview-arrow">›</text>
        </view>
      </button>
      
      <!-- 昵称预览 -->
      <view class="preview-item">
        <text class="preview-label">昵称</text>
        <view class="preview-right">
          <input class="preview-nickname-input" type="nickname" placeholder="{{tempNickname}}" value="{{tempNickname}}" bindinput="onNicknameInput" bindblur="onNicknameBlur" placeholder-class="nickname-placeholder"/>
          <text class="preview-arrow">›</text>
        </view>
      </view>
      
      <!-- 按钮 -->
      <view class="login-btns">
        <view class="login-btn confirm" bindtap="confirmRegister">确认</view>
        <view class="login-btn cancel" bindtap="cancelRegister">取消</view>
      </view>
    </view>
  </view>
</view>
