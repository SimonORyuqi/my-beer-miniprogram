/* pages/order/list/list.wxss - 订单列表页样式 */

.container {
  min-height: 100vh;
  background: #FFF8F0;
}

/* Tab栏 */
.tab-bar {
  background: #FFFFFF;
  border-bottom: 1rpx solid #E8E0D8;
  position: sticky;
  top: 0;
  z-index: 10;
}

.tab-scroll {
  white-space: nowrap;
}

.tab-item {
  display: inline-block;
  padding: 24rpx 32rpx;
  font-size: 28rpx;
  color: #666666;
  position: relative;
}

.tab-item.active {
  color: #D4A017;
  font-weight: bold;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 48rpx;
  height: 4rpx;
  background: #D4A017;
  border-radius: 2rpx;
}

/* 订单列表 */
.order-list {
  padding: 20rpx;
}

.order-card {
  background: #FFFFFF;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(139, 69, 19, 0.08);
}

/* 订单头部 */
.order-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 24rpx;
  border-bottom: 1rpx solid #F0EBE5;
}

.order-id {
  font-size: 24rpx;
  color: #999999;
}

.order-status {
  font-size: 26rpx;
  font-weight: bold;
}

.status-pending { color: #FF6B35; }
.status-paid { color: #1890FF; }
.status-accepted { color: #1890FF; }
.status-making { color: #1890FF; }
.status-ready { color: #52C41A; }
.status-completed { color: #999999; }
.status-cancelled { color: #999999; }
.status-refunded { color: #999999; }

/* 商品列表 */
.order-items {
  padding: 20rpx 24rpx;
}

.order-item {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.order-item:last-child {
  margin-bottom: 0;
}

.item-image {
  width: 80rpx;
  height: 80rpx;
  border-radius: 8rpx;
  background: #F5F5F5;
  margin-right: 16rpx;
}

.item-info {
  flex: 1;
}

.item-name {
  display: block;
  font-size: 26rpx;
  color: #333333;
  margin-bottom: 4rpx;
}

.item-price {
  display: block;
  font-size: 24rpx;
  color: #666666;
}

.more-items {
  font-size: 24rpx;
  color: #999999;
  text-align: center;
  padding-top: 12rpx;
}

/* 订单底部 */
.order-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 24rpx;
  border-top: 1rpx solid #F0EBE5;
}

.order-info {
  display: flex;
  flex-direction: column;
}

.order-time {
  font-size: 22rpx;
  color: #999999;
  margin-bottom: 4rpx;
}

.order-pickup {
  font-size: 22rpx;
  color: #666666;
}

.order-total {
  display: flex;
  align-items: baseline;
}

.total-label {
  font-size: 24rpx;
  color: #666666;
}

.total-price {
  font-size: 32rpx;
  font-weight: bold;
  color: #E85A4F;
}

/* 操作按钮 */
.order-actions {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  padding: 20rpx 24rpx;
  border-top: 1rpx solid #F0EBE5;
}

.action-btn {
  padding: 12rpx 28rpx;
  border-radius: 32rpx;
  font-size: 24rpx;
  font-weight: bold;
}

.action-btn.primary {
  background: #D4A017;
  color: #FFFFFF;
}

.action-btn.secondary {
  background: #FFFFFF;
  color: #666666;
  border: 1rpx solid #E8E0D8;
}

.action-btn.cancel {
  background: #FFFFFF;
  color: #999999;
  border: 1rpx solid #E8E0D8;
}

.action-btn.delete {
  background: #F5F5F5;
  color: #999999;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 24rpx;
  opacity: 0.5;
}

.empty-text {
  font-size: 28rpx;
  color: #666666;
}
