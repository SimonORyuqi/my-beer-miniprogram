/* pages/points/mall/mall.wxss - 积分商城页面样式 */

.container {
  min-height: 100vh;
  background: #FFF8F0;
  padding: 24rpx;
  padding-bottom: 40rpx;
}

/* 通用卡片样式 */
.card {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(139, 69, 19, 0.08);
  margin-bottom: 24rpx;
}

/* 积分余额卡片 */
.points-card {
  background: linear-gradient(135deg, #D4A017 0%, #BF8E14 100%);
  color: #FFFFFF;
}

.points-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.points-label {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.9);
}

.points-detail-btn {
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.2);
  padding: 10rpx 20rpx;
  border-radius: 30rpx;
}

.points-detail-btn:active {
  background: rgba(255, 255, 255, 0.3);
}

.detail-icon {
  font-size: 24rpx;
  margin-right: 8rpx;
}

.detail-text {
  font-size: 24rpx;
  color: #FFFFFF;
}

.detail-arrow {
  font-size: 28rpx;
  color: #FFFFFF;
  margin-left: 4rpx;
}

.points-amount {
  display: flex;
  align-items: baseline;
  justify-content: center;
  padding: 20rpx 0;
}

.amount-value {
  font-size: 80rpx;
  font-weight: bold;
  color: #FFFFFF;
}

.amount-unit {
  font-size: 32rpx;
  color: rgba(255, 255, 255, 0.9);
  margin-left: 8rpx;
}

/* 兑换商品列表 */
.products-section {
  margin-top: 8rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 20rpx;
}

.products-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

/* 商品卡片 - 左图右文布局 */
.product-item {
  display: flex;
  align-items: flex-start;
  padding: 24rpx;
  transition: all 0.2s ease;
}

.product-item:active {
  opacity: 0.9;
  transform: scale(0.98);
}

/* 左侧商品图片 */
.product-image {
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
  margin-right: 24rpx;
  flex-shrink: 0;
  background: #F5F5F5;
}

/* 右侧商品信息 */
.product-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-height: 200rpx;
}

.product-header {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.product-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333333;
  margin-right: 12rpx;
}

.product-type {
  font-size: 22rpx;
  color: #D4A017;
  background: #FFF8F0;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  border: 1rpx solid #D4A017;
}

.product-desc {
  font-size: 24rpx;
  color: #666666;
  margin-bottom: 16rpx;
  line-height: 1.5;
}

/* 底部积分和操作按钮 */
.product-action {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: auto;
}

.points-cost {
  display: flex;
  align-items: baseline;
}

.cost-value {
  font-size: 40rpx;
  font-weight: bold;
  color: #D4A017;
}

.cost-unit {
  font-size: 22rpx;
  color: #666666;
  margin-left: 4rpx;
}

.exchange-btn {
  background: #D4A017;
  border-radius: 8rpx;
  padding: 12rpx 32rpx;
  transition: all 0.2s;
}

.exchange-btn:active {
  background: #BF8E14;
}

.exchange-btn.disabled {
  background: #CCCCCC;
}

.btn-text {
  font-size: 26rpx;
  font-weight: bold;
  color: #FFFFFF;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 40rpx;
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 30rpx;
  color: #333333;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 24rpx;
  color: #999999;
}