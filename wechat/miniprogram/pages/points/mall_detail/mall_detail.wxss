/* 商品图片区域 */
.product-image-section {
  width: 100%;
  height: 600rpx;
  background: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
}

.product-image {
  width: 100%;
  height: 100%;
}

/* 商品信息区域 */
.product-info-section {
  background: #FFFFFF;
  margin: 24rpx;
  border-radius: 16rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 20rpx rgba(139, 69, 19, 0.08);
}

.product-header {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.product-name {
  font-size: 36rpx;
  font-weight: bold;
  color: #333333;
  margin-right: 16rpx;
}

.product-type {
  font-size: 22rpx;
  color: #D4A017;
  background: #FFF8F0;
  padding: 4rpx 16rpx;
  border-radius: 6rpx;
  border: 1rpx solid #D4A017;
}

.product-desc {
  font-size: 28rpx;
  color: #666666;
  margin-bottom: 24rpx;
  line-height: 1.6;
}

.points-cost {
  display: flex;
  align-items: baseline;
  padding: 16rpx 0;
  border-top: 1rpx solid #F0F0F0;
}

.cost-label {
  font-size: 28rpx;
  color: #666666;
  margin-right: 12rpx;
}

.cost-value {
  font-size: 44rpx;
  font-weight: bold;
  color: #D4A017;
}

.cost-unit {
  font-size: 24rpx;
  color: #666666;
  margin-left: 4rpx;
}

/* 兑换说明区域 */
.exchange-notes-section {
  background: #FFFFFF;
  margin: 24rpx;
  border-radius: 16rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 20rpx rgba(139, 69, 19, 0.08);
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 20rpx;
}

.notes-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.note-item {
  display: flex;
  align-items: flex-start;
}

.note-text {
  font-size: 26rpx;
  color: #666666;
  line-height: 1.6;
}

/* 底部兑换按钮 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #FFFFFF;
  padding: 20rpx 32rpx;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.05);
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
}

.exchange-btn {
  background: #D4A017;
  border-radius: 12rpx;
  padding: 24rpx 0;
  text-align: center;
  transition: all 0.2s;
}

.exchange-btn:active {
  background: #BF8E14;
}

.exchange-btn.disabled {
  background: #CCCCCC;
}

.btn-text {
  font-size: 32rpx;
  font-weight: bold;
  color: #FFFFFF;
}