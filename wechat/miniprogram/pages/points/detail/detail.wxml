<view class="container">
  <!-- 筛选标签栏 -->
  <view class="filter-tabs">
    <view 
      class="tab-item {{currentFilter === 'all' ? 'active' : ''}}"
      bindtap="switchFilter"
      data-type="all"
    >
      <text class="tab-text">全部</text>
    </view>
    <view 
      class="tab-item {{currentFilter === 'earn' ? 'active' : ''}}"
      bindtap="switchFilter"
      data-type="earn"
    >
      <text class="tab-text">获得</text>
    </view>
    <view 
      class="tab-item {{currentFilter === 'spend' ? 'active' : ''}}"
      bindtap="switchFilter"
      data-type="spend"
    >
      <text class="tab-text">消耗</text>
    </view>
    <view 
      class="tab-item {{currentFilter === 'expire' ? 'active' : ''}}"
      bindtap="switchFilter"
      data-type="expire"
    >
      <text class="tab-text">过期</text>
    </view>
  </view>

  <!-- 积分明细列表 -->
  <view class="records-list" wx:if="{{filteredRecords.length > 0}}">
    <view 
      class="record-item card"
      wx:for="{{filteredRecords}}"
      wx:key="id"
    >
      <view class="record-left">
        <view class="record-amount {{item.type === 'earn' ? 'earn' : (item.type === 'spend' ? 'spend' : 'expire')}}">
          <text class="amount-sign">{{item.type === 'earn' ? '+' : '-'}}</text>
          <text class="amount-value">{{item.amount}}</text>
          <text class="amount-unit">分</text>
        </view>
        <view class="record-desc">{{item.description}}</view>
      </view>
      <view class="record-right">
        <view class="record-time">{{item.createTime}}</view>
        <view class="record-type {{item.type}}">
          <text class="type-text">{{item.type === 'earn' ? '获得' : (item.type === 'spend' ? '消耗' : '过期')}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:if="{{filteredRecords.length === 0}}">
    <text class="empty-icon">📝</text>
    <text class="empty-text">暂无积分记录~</text>
    <text class="empty-desc">快去赚取积分吧</text>
  </view>
</view>
