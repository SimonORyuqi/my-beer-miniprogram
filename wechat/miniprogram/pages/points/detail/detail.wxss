/* pages/points/detail/detail.wxss - 积分明细页面样式 */

.container {
  min-height: 100vh;
  background: #FFF8F0;
  padding: 24rpx;
  padding-bottom: 40rpx;
}

/* 通用卡片样式 */
.card {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 20rpx rgba(139, 69, 19, 0.08);
  margin-bottom: 24rpx;
}

/* 筛选标签栏 */
.filter-tabs {
  display: flex;
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 8rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(139, 69, 19, 0.08);
}

.tab-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 72rpx;
  border-radius: 12rpx;
  transition: all 0.2s ease;
}

.tab-item:active {
  opacity: 0.8;
}

.tab-item.active {
  background: #D4A017;
}

.tab-text {
  font-size: 28rpx;
  color: #666666;
}

.tab-item.active .tab-text {
  color: #FFFFFF;
  font-weight: bold;
}

/* 积分明细列表 */
.records-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.record-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx;
}

.record-left {
  flex: 1;
  margin-right: 20rpx;
}

.record-amount {
  display: flex;
  align-items: baseline;
  margin-bottom: 8rpx;
}

.record-amount.earn {
  color: #4CAF50;
}

.record-amount.spend {
  color: #E85A4F;
}

.record-amount.expire {
  color: #999999;
}

.amount-sign {
  font-size: 28rpx;
  font-weight: bold;
  margin-right: 4rpx;
}

.amount-value {
  font-size: 36rpx;
  font-weight: bold;
}

.amount-unit {
  font-size: 22rpx;
  margin-left: 4rpx;
}

.record-desc {
  font-size: 24rpx;
  color: #666666;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.record-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.record-time {
  font-size: 22rpx;
  color: #999999;
  margin-bottom: 8rpx;
}

.record-type {
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
}

.record-type.earn {
  background: #E8F5E9;
}

.record-type.earn .type-text {
  color: #4CAF50;
}

.record-type.spend {
  background: #FFEBEE;
}

.record-type.spend .type-text {
  color: #E85A4F;
}

.record-type.expire {
  background: #F5F5F5;
}

.record-type.expire .type-text {
  color: #999999;
}

.type-text {
  font-size: 22rpx;
  font-weight: 500;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 40rpx;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 30rpx;
  color: #333333;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 24rpx;
  color: #999999;
}
