<view class="container">
  <!-- 左侧分类栏 -->
  <view class="category-bar">
    <scroll-view scroll-y class="category-scroll">
      <view 
        class="category-item {{currentCategory === item.id ? 'active' : ''}}"
        wx:for="{{categories}}"
        wx:key="id"
        data-id="{{item.id}}"
        bindtap="switchCategory"
      >
        <text class="category-icon">{{item.icon}}</text>
        <text class="category-name">{{item.name}}</text>
      </view>
    </scroll-view>
  </view>

  <!-- 右侧商品列表 -->
  <view class="product-list">
    <scroll-view scroll-y class="product-scroll">
      <view class="product-grid">
        <view 
          class="product-card"
          wx:for="{{products}}"
          wx:key="id"
        >
          <image class="product-image" src="{{item.image}}" mode="aspectFill" bindtap="selectProduct" data-id="{{item.id}}"></image>
          <view class="product-right">
            <view class="product-main" bindtap="selectProduct" data-id="{{item.id}}">
              <text class="product-name">{{item.name}}</text>
              <text class="product-style">{{item.styleName}} · {{item.volume}}</text>
              <view class="product-meta">
                <text class="product-abv">{{item.abv}}% ABV</text>
                <text class="product-ibu">{{item.ibu}} IBU</text>
              </view>
              <view class="product-rating">
                <text class="stars">⭐ {{item.rating}}</text>
                <text class="reviews">({{item.reviews}})</text>
              </view>
            </view>
            <view class="product-footer">
              <view class="product-price">
                <text class="price">¥{{item.price}}</text>
                <text class="original-price" wx:if="{{item.originalPrice > item.price}}">¥{{item.originalPrice}}</text>
              </view>
              <view class="product-qty-control">
                <view class="qty-minus {{item.cartQuantity > 0 ? 'show' : ''}}" bindtap="reduceFromCard" data-id="{{item.id}}">
                  <text>−</text>
                </view>
                <text class="qty-num {{item.cartQuantity > 0 ? 'show' : ''}}">{{item.cartQuantity}}</text>
                <view class="qty-plus" bindtap="addToCart" data-id="{{item.id}}">
                  <text>+</text>
                </view>
              </view>
            </view>
          </view>
          <view class="promo-tag" wx:if="{{item.originalPrice > item.price}}">
            <text>特惠</text>
          </view>
        </view>
      </view>
      
      <!-- 空状态 -->
      <view class="empty-state" wx:if="{{products.length === 0}}">
        <text class="empty-icon">🍺</text>
        <text>暂无相关酒款</text>
      </view>
    </scroll-view>
  </view>

  <!-- 购物车悬浮框 -->
  <view class="cart-float" wx:if="{{showCart}}" bindtap="toggleCart">
    <view class="cart-content" catchtap="stopPropagation">
      <view class="cart-header">
        <text class="cart-title">购物车</text>
        <text class="cart-clear" bindtap="clearCart">清空</text>
      </view>
      <scroll-view scroll-y class="cart-items">
        <view class="cart-item" wx:for="{{cartList}}" wx:key="cartKey">
          <view class="cart-item-image-box">
            <image class="cart-item-image" src="{{item.image}}" mode="aspectFill"></image>
            <view class="cart-item-badge">
              <text>{{item.quantity}}</text>
            </view>
          </view>
          <view class="cart-item-info">
            <text class="cart-item-name">{{item.name}}</text>
            <text class="cart-item-spec">{{item.volume}}</text>
            <text class="cart-item-price">¥{{item.price}}</text>
          </view>
          <view class="cart-item-actions">
            <text class="qty-btn" catchtap="reduceQuantity" data-cartkey="{{item.cartKey}}">-</text>
            <text class="qty-btn" catchtap="addQuantity" data-cartkey="{{item.cartKey}}">+</text>
          </view>
        </view>
      </scroll-view>
      <view class="cart-footer">
        <view class="cart-total">
          <text class="total-label">合计：</text>
          <text class="total-price">¥{{totalPrice}}</text>
        </view>
        <view class="checkout-btn" catchtap="goCheckout">去结算</view>
      </view>
    </view>
  </view>

  <!-- 底部悬浮购物车栏 -->
  <view class="cart-bar {{totalCount > 0 ? 'show' : ''}}" wx:if="{{totalCount > 0}}" bindtap="toggleCart">
    <view class="cart-bar-left">
      <view class="cart-bar-icon-box">
        <text class="cart-bar-icon">🛒</text>
        <view class="cart-bar-badge">
          <text>{{totalCount}}</text>
        </view>
      </view>
      <view class="cart-bar-divider"></view>
      <view class="cart-bar-price">
        <text class="cart-bar-total">¥{{totalPrice}}</text>
      </view>
    </view>
    <view class="cart-bar-right">
      <text class="cart-bar-text">选好了</text>
      <text class="cart-bar-arrow">›</text>
    </view>
  </view>

  <!-- 规格选择弹窗 -->
  <view class="spec-modal {{showSpecModal ? 'show' : ''}}" wx:if="{{showSpecModal}}" bindtap="closeSpecModal">
    <view class="spec-content" catchtap="stopPropagation">
      <view class="spec-header">
        <image class="spec-product-image" src="{{selectedProduct.image}}" mode="aspectFill"></image>
        <view class="spec-product-info">
          <text class="spec-product-name">{{selectedProduct.name}}</text>
          <text class="spec-product-style">{{selectedProduct.styleName}} · {{selectedProduct.abv}}% ABV</text>
        </view>
        <view class="spec-close" bindtap="closeSpecModal">✕</view>
      </view>
      <view class="spec-body">
        <text class="spec-label">选择规格</text>
        <view class="spec-list">
          <view 
            class="spec-item {{selectedSpecIndex === index ? 'selected' : ''}}"
            wx:for="{{selectedProduct.specs}}"
            wx:key="index"
            data-index="{{index}}"
            bindtap="selectSpec"
          >
            <text class="spec-name">{{item.name}}</text>
            <text class="spec-price">¥{{item.price}}</text>
          </view>
        </view>
      </view>
      <view class="spec-footer">
        <view class="spec-total">
          <text class="spec-total-label">合计：</text>
          <text class="spec-total-price">¥{{selectedSpecPrice}}</text>
        </view>
        <view class="spec-add-btn" bindtap="confirmAddToCart">
          <text>加入购物车</text>
        </view>
      </view>
    </view>
  </view>
</view>
