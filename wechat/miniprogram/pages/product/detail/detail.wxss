/* pages/product/detail/detail.wxss - 商品详情页样式 */

.container {
  min-height: 100vh;
  background: #FFF8F0;
  padding-bottom: 140rpx;
}

/* 商品图片 */
.product-image-wrapper {
  position: relative;
  width: 100%;
  height: 500rpx;
  background: #FFFFFF;
}

.product-image {
  width: 100%;
  height: 100%;
}

.back-btn {
  position: absolute;
  top: 60rpx;
  left: 32rpx;
  width: 64rpx;
  height: 64rpx;
  background: rgba(255, 255, 255, 0.9);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: #333333;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.style-tag {
  position: absolute;
  bottom: 24rpx;
  right: 24rpx;
  background: #D4A017;
  color: #FFFFFF;
  font-size: 24rpx;
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
}

/* 基础信息 */
.basic-info {
  padding: 32rpx;
  background: #FFFFFF;
  margin-bottom: 20rpx;
}

.product-name {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 8rpx;
}

.product-name-en {
  display: block;
  font-size: 26rpx;
  color: #999999;
  margin-bottom: 24rpx;
}

.product-meta {
  display: flex;
  gap: 40rpx;
  margin-bottom: 24rpx;
}

.meta-item {
  display: flex;
  flex-direction: column;
}

.meta-label {
  font-size: 22rpx;
  color: #999999;
  margin-bottom: 4rpx;
}

.meta-value {
  font-size: 26rpx;
  color: #333333;
}

.product-stats {
  display: flex;
  justify-content: space-between;
  background: #FFF8F0;
  padding: 20rpx;
  border-radius: 12rpx;
  margin-bottom: 24rpx;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-value {
  font-size: 28rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 4rpx;
}

.stat-label {
  font-size: 20rpx;
  color: #666666;
}

.price-row {
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
  gap: 16rpx;
}

.current-price {
  font-size: 40rpx;
  font-weight: bold;
  color: #E85A4F;
}

.original-price {
  font-size: 26rpx;
  color: #999999;
  text-decoration: line-through;
}

.stock-info {
  font-size: 24rpx;
  color: #666666;
  margin-left: auto;
}

/* 通用区块 */
.section {
  background: #FFFFFF;
  padding: 32rpx;
  margin-bottom: 20rpx;
}

.section-title {
  display: block;
  font-size: 30rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 20rpx;
}

/* 风味描述 */
.flavor-card {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.flavor-item {
  display: flex;
  align-items: flex-start;
}

.flavor-icon {
  font-size: 32rpx;
  margin-right: 16rpx;
}

.flavor-content {
  flex: 1;
}

.flavor-label {
  display: block;
  font-size: 24rpx;
  color: #D4A017;
  font-weight: bold;
  margin-bottom: 4rpx;
}

.flavor-text {
  display: block;
  font-size: 26rpx;
  color: #666666;
  line-height: 1.6;
}

/* 搭配建议 */
.pairing-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.pairing-tag {
  background: rgba(212, 160, 23, 0.1);
  color: #D4A017;
  font-size: 26rpx;
  padding: 12rpx 24rpx;
  border-radius: 8rpx;
}

/* 商品简介 */
.desc-text {
  font-size: 26rpx;
  color: #666666;
  line-height: 1.8;
}

/* 底部操作栏 */
.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #FFFFFF;
  padding: 20rpx 32rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.05);
  z-index: 100;
}

.quantity-section {
  display: flex;
  align-items: center;
  margin-right: 24rpx;
}

.qty-label {
  font-size: 26rpx;
  color: #666666;
  margin-right: 16rpx;
}

.qty-controls {
  display: flex;
  align-items: center;
}

.qty-btn {
  width: 48rpx;
  height: 48rpx;
  background: #F5F5F5;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #333333;
}

.qty-num {
  min-width: 60rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: bold;
  color: #333333;
}

.action-btns {
  flex: 1;
  display: flex;
  gap: 16rpx;
}

.add-cart-btn {
  flex: 1;
  background: #FFFFFF;
  color: #D4A017;
  border: 2rpx solid #D4A017;
  padding: 24rpx;
  border-radius: 48rpx;
  font-size: 28rpx;
  font-weight: bold;
  text-align: center;
}

.add-cart-btn:active {
  background: rgba(212, 160, 23, 0.1);
}

.buy-btn {
  flex: 1;
  background: #D4A017;
  color: #FFFFFF;
  padding: 24rpx;
  border-radius: 48rpx;
  font-size: 28rpx;
  font-weight: bold;
  text-align: center;
}

.buy-btn:active {
  background: #BF8E14;
}
