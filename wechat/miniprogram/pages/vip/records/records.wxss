/* pages/vip/records/records.wxss - 充值记录页面样式 */

.container {
  min-height: 100vh;
  background: #FFF8F0;
  padding: 24rpx;
  padding-bottom: 40rpx;
}

/* 通用卡片样式 */
.card {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 20rpx rgba(139, 69, 19, 0.08);
}

/* 统计概览卡片 */
.stats-card {
  display: flex;
  align-items: center;
  justify-content: space-around;
  margin-bottom: 32rpx;
  background: linear-gradient(135deg, #333333 0%, #4A3728 100%);
  color: #FFFFFF;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

.stat-value {
  font-size: 36rpx;
  font-weight: bold;
  color: #D4A017;
  margin-bottom: 8rpx;
}

.stat-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.7);
}

.stat-divider {
  width: 1rpx;
  height: 60rpx;
  background: rgba(255, 255, 255, 0.2);
}

/* 充值记录列表 */
.records-section {
  margin-top: 16rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 20rpx;
  padding-left: 8rpx;
}

.records-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.record-item {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 28rpx 32rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: 0 4rpx 16rpx rgba(139, 69, 19, 0.06);
}

.record-left {
  display: flex;
  flex-direction: column;
}

.record-amount {
  font-size: 36rpx;
  font-weight: bold;
  color: #E85A4F;
  margin-bottom: 8rpx;
}

.record-bonus {
  font-size: 24rpx;
  color: #4CAF50;
}

.record-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.record-time {
  font-size: 24rpx;
  color: #999999;
  margin-bottom: 8rpx;
}

.record-points {
  font-size: 22rpx;
  color: #D4A017;
  background: #FFF8F0;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 32rpx;
  color: #D4A017;
  font-weight: bold;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #999999;
}
