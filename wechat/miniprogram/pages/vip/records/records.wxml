<view class="container">
  <!-- 统计概览 -->
  <view class="stats-card card">
    <view class="stat-item">
      <text class="stat-value">¥{{totalAmount}}</text>
      <text class="stat-label">累计充值</text>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item">
      <text class="stat-value">{{totalGrowth}}</text>
      <text class="stat-label">累计成长值</text>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item">
      <text class="stat-value">{{totalPoints}}</text>
      <text class="stat-label">累计积分</text>
    </view>
  </view>

  <!-- 充值记录列表 -->
  <view class="records-section">
    <view class="section-title">充值明细</view>
    
    <view class="records-list" wx:if="{{records.length > 0}}">
      <view 
        class="record-item"
        wx:for="{{records}}"
        wx:key="id"
      >
        <view class="record-left">
          <view class="record-amount">+¥{{item.amount}}</view>
          <view class="record-bonus" wx:if="{{item.bonus > 0}}">赠送 ¥{{item.bonus}}</view>
        </view>
        <view class="record-right">
          <view class="record-time">{{item.time}}</view>
          <view class="record-points">+{{item.growth}}成长值 +{{item.points}}积分</view>
        </view>
      </view>
    </view>

    <!-- 空状态 -->
    <view class="empty-state" wx:if="{{records.length === 0}}">
      <text class="empty-icon">💰</text>
      <text class="empty-text">还没有充值记录~</text>
      <text class="empty-desc">快去充值成为会员吧</text>
    </view>
  </view>
</view>
