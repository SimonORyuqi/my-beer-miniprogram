<view class="container">
  <!-- 账户余额卡片 -->
  <view class="balance-card card">
    <view class="balance-header">
      <text class="balance-label">账户余额</text>
      <view class="header-btns">
        <view class="records-btn" bindtap="goToRecords">
          <text class="records-icon">📋</text>
          <text class="records-text">充值记录</text>
        </view>
        <view class="records-btn" bindtap="goToConsumeRecords">
          <text class="records-icon">🧾</text>
          <text class="records-text">消费记录</text>
        </view>
      </view>
    </view>
    <view class="balance-amount">
      <text class="amount-yen">¥</text>
      <text class="amount-value">{{balance}}</text>
    </view>
  </view>





  <!-- 充值套餐区 -->
  <view class="recharge-section">
    <view class="section-title">选择充值套餐</view>
    <view class="recharge-packages">
      <view 
        wx:for="{{rechargePackages}}" 
        wx:key="id"
        class="package-item {{selectedPackage === item.id ? 'selected' : ''}}"
        bindtap="selectPackage"
        data-id="{{item.id}}"
      >
        <view class="package-amount">
          <text class="amount-yen">¥</text>
          <text class="amount-value">{{item.amount}}</text>
        </view>
        <view class="package-bonus">
          <text class="bonus-text">赠送 ¥{{item.bonus}}</text>
        </view>
        <view class="package-growth">
          <text class="growth-text">+{{item.growth}} 成长值</text>
        </view>
        <view class="package-selected-icon" wx:if="{{selectedPackage === item.id}}">✓</view>
      </view>
    </view>
  </view>

  <!-- 充值按钮 -->
  <view class="recharge-action">
    <view class="recharge-summary">
      <text class="summary-label">实际到账</text>
      <text class="summary-value">¥{{actualAmount}}</text>
      <text class="summary-unit">元</text>
    </view>
    <view class="recharge-btn {{!selectedPackage ? 'disabled' : ''}}" bindtap="goToRecharge">
      <text class="btn-text">立即充值</text>
    </view>
  </view>

  <!-- 温馨提示 -->
  <view class="tips">
    <text class="tips-text">🍻 温馨提示：购买酒类商品需年满18周岁</text>
    <text class="tips-desc">充值金额不可兑换现金、不找零，用完失效</text>
  </view>

  <!-- 年龄确认弹窗 -->
  <view class="age-modal {{showAgeModal ? 'show' : ''}}" wx:if="{{showAgeModal}}">
    <view class="age-mask"></view>
    <view class="age-content">
      <view class="age-icon">🍺</view>
      <view class="age-title">年龄验证</view>
      <view class="age-desc">购买酒类商品需年满18周岁</view>
      <view class="age-question">请问您是否已年满18周岁？</view>
      <view class="age-btns">
        <view class="age-btn confirm" bindtap="confirmAge">是的，我已满18岁</view>
        <view class="age-btn cancel" bindtap="cancelAge">抱歉，我未满18岁</view>
      </view>
    </view>
  </view>

  <!-- 充值成功弹窗 -->
  <view class="success-modal {{showSuccessModal ? 'show' : ''}}" wx:if="{{showSuccessModal}}">
    <view class="success-mask"></view>
    <view class="success-content">
      <view class="success-icon">🎉</view>
      <view class="success-title">充值成功</view>
      <view class="success-details">
        <view class="detail-row">
          <text class="detail-label">充值金额</text>
          <text class="detail-value">¥{{rechargedAmount}}</text>
        </view>
        <view class="detail-row">
          <text class="detail-label">获得成长值</text>
          <text class="detail-value">+{{rechargedGrowth}}</text>
        </view>
        <view class="detail-row">
          <text class="detail-label">获得积分</text>
          <text class="detail-value">+{{rechargedPoints}}</text>
        </view>
      </view>
      <view class="success-progress">
        <text class="progress-title">会员进度</text>
        <view class="progress-bar-wrap">
          <view class="progress-bar">
            <view class="progress-fill" style="width: {{newGrowthProgress}}%"></view>
          </view>
          <view class="progress-labels">
            <text>{{userInfo.growthValue}}</text>
            <text>{{nextLevelGrowth}}</text>
          </view>
        </view>
      </view>
      <view class="success-btns">
        <view class="success-btn primary" bindtap="continueRecharge">继续充值</view>
        <view class="success-btn secondary" bindtap="closeSuccessModal">关闭</view>
      </view>
    </view>
  </view>
</view>
