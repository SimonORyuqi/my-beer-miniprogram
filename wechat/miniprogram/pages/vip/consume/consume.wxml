<view class="container">
  <!-- 消费记录列表 -->
  <view class="records-section">
    <view class="section-title">消费明细</view>
    
    <view class="records-list" wx:if="{{records.length > 0}}">
      <view 
        class="record-item"
        wx:for="{{records}}"
        wx:key="id"
      >
        <view class="record-left">
          <view class="record-amount">-¥{{item.amount}}</view>
          <view class="record-order" wx:if="{{item.orderNo}}">订单号: {{item.orderNo}}</view>
        </view>
        <view class="record-right">
          <view class="record-time">{{item.time}}</view>
          <view class="record-status">已消费</view>
        </view>
      </view>
    </view>

    <!-- 空状态 -->
    <view class="empty-state" wx:if="{{records.length === 0}}">
      <text class="empty-icon">📝</text>
      <text class="empty-text">还没有消费记录~</text>
      <text class="empty-desc">快去下单购买吧</text>
    </view>
  </view>
</view>
