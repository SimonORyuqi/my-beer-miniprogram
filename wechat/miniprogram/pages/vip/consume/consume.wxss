/* pages/vip/consume/consume.wxss - 消费记录页面样式 */

.container {
  min-height: 100vh;
  background: #FFF8F0;
  padding: 24rpx;
  padding-bottom: 40rpx;
}

/* 消费记录列表 */
.records-section {
  margin-top: 16rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 20rpx;
  padding-left: 8rpx;
}

.records-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.record-item {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 28rpx 32rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: 0 4rpx 16rpx rgba(139, 69, 19, 0.06);
}

.record-left {
  display: flex;
  flex-direction: column;
}

.record-amount {
  font-size: 36rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 8rpx;
}

.record-order {
  font-size: 22rpx;
  color: #999999;
}

.record-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.record-time {
  font-size: 24rpx;
  color: #999999;
  margin-bottom: 8rpx;
}

.record-status {
  font-size: 22rpx;
  color: #4CAF50;
  background: #E8F5E9;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 0;
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 32rpx;
  color: #D4A017;
  font-weight: bold;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #999999;
}
